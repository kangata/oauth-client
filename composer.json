{
    "name": "quetzal-studio/oauth-client",
    "license": "MIT",
    "authors": [
        {
            "name": "Ata",
            "email": "quetzalskeith@gmail.com"
        }
    ],
    "require": {
        "php": "^7.3|^8.0",
        "illuminate/support": "^8.2|^9.0|^10.0|^11.0|^12.0",
        "laravel/passport": "^10.0|^11.0|^12.0",
        "league/oauth2-server": "^8.1",
        "nyholm/psr7": "^1.3",
        "spatie/laravel-permission": "^5.0|^6.0",
        "symfony/psr-http-message-bridge": "^2.0|^6.0|^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.10"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "QuetzalStudio\\OAuthClient\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "QuetzalStudio\\OAuthClient\\OAuthClientServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
